name = "CCllff-jpg/moondicom"

version = "0.1.2"

readme = "README.mbt.md"

source = "."

repository = "https://github.com/CCllff-jpg/MoonDICOM-MoonBit-.git"

license = "Apache-2.0"

keywords = [
  "dicom",
  "medical-imaging",
  "privacy",
  "deidentification",
  "binary-parser",
]

